# ── Clerk (auth) ─────────────────────────────────────────────────────────────
# https://dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ── Database (Supabase Postgres) ─────────────────────────────────────────────
# DATABASE_URL  = pooled connection (Supavisor, port 6543) — used by the app at runtime
# DIRECT_URL    = direct connection (port 5432) — used by `prisma migrate` / `prisma db push`
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# ── Supabase Realtime (live leaderboard; optional — app falls back to polling) ──
# Project Settings → API. Also run once in the SQL editor so inserts are broadcast:
#   alter publication supabase_realtime add table "LedgerEntry";
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# ── Cloudflare R2 (pushup-set video clips) ───────────────────────────────────
# R2 → Manage R2 API Tokens (S3-compatible credentials).
# Bucket needs a CORS rule allowing PUT from your app origin, e.g.:
#   [{"AllowedOrigins":["https://pentix.eu","http://localhost:3000"],"AllowedMethods":["PUT","GET"],"AllowedHeaders":["*"]}]
# R2_PUBLIC_BASE_URL = the bucket's public URL (r2.dev or custom domain), no trailing slash.
R2_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
R2_ACCESS_KEY_ID=xxx
R2_SECRET_ACCESS_KEY=xxx
R2_BUCKET=pentix-clips
R2_PUBLIC_BASE_URL=https://pub-xxxxxxxx.r2.dev

# ── Cron (daily interest job) ────────────────────────────────────────────────
# Set the same value in Vercel env vars; Vercel Cron sends it as `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=change-me

# ── World Cup live scores (optional, best-effort prefill only) ───────────────
# Self-hosted or public instance of github.com/rezarahiminia/worldcup2026.
# Leave empty to disable the live-score suggestion feature entirely.
WC_API_BASE=
WC_API_JWT=

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Local demo only ──────────────────────────────────────────────────────────
# DEV_AUTH_BYPASS=1 runs the app without Clerk using a single fake user
# (ignored in production builds). Pair with scripts/dev-db.mjs for a local DB.
# DEV_AUTH_BYPASS=1
